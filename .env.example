# AuraJob environment configuration
# Copy this file to .env and fill in the real values for your machine.
# NEVER commit the .env file — it contains credentials.

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aurajob_db
DB_USER=aurajob_app
DB_PASS=change-me

# Application encryption key (AES-256-GCM) used to encrypt applicant phone
# numbers at rest. Must be a 256-bit key: 64 hex chars (or 44 base64 chars, or
# 32 raw bytes). Generate with:  php -r "echo bin2hex(random_bytes(32));"
# NEVER commit the real .env value - generate one locally.
APP_ENCRYPTION_KEY=